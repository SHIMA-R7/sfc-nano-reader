<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- USB接続 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="USB接続" />

        <TextView
            android:id="@+id/tvConnStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="未接続" />
    </LinearLayout>

    <!-- 保存先フォルダ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btnPickFolder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="保存先を選択" />

        <TextView
            android:id="@+id/tvFolderPath"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="(未選択)"
            android:maxLines="1"
            android:ellipsize="middle" />
    </LinearLayout>

    <!-- カート情報 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="カート情報"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCartInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:background="#F0F0F0"
        android:text="(未判定)"
        android:layout_marginBottom="8dp" />

    <!-- マッピング手動指定 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="マッピング:" />

        <RadioGroup
            android:id="@+id/radioMapping"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="8dp">

            <RadioButton
                android:id="@+id/radioAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="自動" />

            <RadioButton
                android:id="@+id/radioLoRom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LoROM" />

            <RadioButton
                android:id="@+id/radioHiRom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HiROM" />
        </RadioGroup>
    </LinearLayout>

    <!-- 操作 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/btnIdentify"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="カートを判定" />

        <Button
            android:id="@+id/btnDump"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="ダンプ開始" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:enabled="false"
            android:text="中止" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvProgressLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="待機中" />

    <ProgressBar
        android:id="@+id/progressDump"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="0"
        android:layout_marginBottom="8dp" />

    <!-- ログ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ログ"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCopyLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ログをコピー" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F0F0F0">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:text="" />
    </ScrollView>

</LinearLayout>
